  "news": [
    {
      "title": "PlayStation 9月3日连播两场 State of Play",
      "date": "2026-08-31",
      "summary": "两场节目将连续播出，重点覆盖全球、日本与亚洲开发团队，《最终幻想7：启示》将获得长篇展示。",
      "source": "游民星空／PlayStation",
      "url": "https://www.gamersky.com/news/202608/2199920.shtml",
      "image": "game-brief-assets/2026-09-01-news-01.jpg"
    },
    {
      "title": "8月国产游戏版号公布，《英雄无敌3》重制版获批",
      "date": "2026-08-31",
      "summary": "国家新闻出版署公开8月审批信息，育碧成都与上海团队主导研发的经典策略重制项目确认取得版号。",
      "source": "游民星空／国家新闻出版署",
      "url": "https://www.gamersky.com/news/202608/2199915.shtml",
      "image": "game-brief-assets/2026-09-01-news-02.jpg"
    },
    {
      "title": "《艾尔登法环》确认继续更新改善",
      "date": "2026-08-31",
      "summary": "FromSoftware 在褪色者版相关公告中表示后续仍会持续改善游戏体验，并已为新版本与追加内容完成配套更新。",
      "source": "游民星空／FromSoftware",
      "url": "https://www.gamersky.com/news/202608/2199743.shtml",
      "image": "game-brief-assets/2026-09-01-news-03.jpg"
    },
    {
      "title": "《昭和米国物语》筹备国内试玩活动",
      "date": "2026-08-31",
      "summary": "制作人确认国内试玩已进入筹备阶段，团队同时回应科隆展现场试玩奖励问题并向未能领取的玩家致歉。",
      "source": "游民星空／铃空游戏",
      "url": "https://www.gamersky.com/news/202608/2199876.shtml",
      "image": "game-brief-assets/2026-09-01-news-04.jpg"
    },
    {
      "title": "《鬼武者：剑之道》获 IGN 10 分",
      "date": "2026-08-31",
      "summary": "评测肯定一闪、防反、弹刀与 Boss 战的系统深度，并称经典系列的现代化重启兼顾动作与叙事。",
      "source": "游民星空／IGN",
      "url": "https://www.gamersky.com/news/202608/2199952.shtml",
      "image": "game-brief-assets/2026-09-01-news-05.jpg"
    },
    {
      "title": "《黎明行者之血》获 IGN 9 分",
      "date": "2026-08-31",
      "summary": "IGN 肯定昼夜双形态战斗、时间限制与剧情选择，认为其是近年突出的叙事驱动吸血鬼 RPG。",
      "source": "游民星空／IGN",
      "url": "https://www.gamersky.com/news/202608/2199953.shtml",
      "image": "game-brief-assets/2026-09-01-news-06.jpg"
    },
    {
      "title": "《堕落之主2》公布战斗与世界升级方向",
      "date": "2026-08-31",
      "summary": "官方表示续作将强化战斗响应、Boss 战、Build 选择、角色塑造与世界多样性，计划于2027年第一季度推出。",
      "source": "游民星空／CI Games",
      "url": "https://www.gamersky.com/news/202608/2199927.shtml",
      "image": "game-brief-assets/2026-09-01-news-07.jpg"
    },
    {
      "title": "网易《射雕》审批名称变更为《千里之路》",
      "date": "2026-08-31",
      "summary": "最新游戏审批变更信息显示项目名称和出版单位发生调整；报道明确将后续运营可能性标为分析而非官方结论。",
      "source": "游民星空／国家新闻出版署",
      "url": "https://www.gamersky.com/news/202608/2199919.shtml",
      "image": "game-brief-assets/2026-09-01-news-08.jpg"
    },
    {
      "title": "《真三国无双4》领跑制作人非官方重制投票",
      "date": "2026-08-31",
      "summary": "系列制作人个人发起的问卷中，《真三国无双4》获56.4%支持；该结果不代表光荣特库摩已立项。",
      "source": "游民星空／庄知彦",
      "url": "https://www.gamersky.com/news/202608/2199934.shtml",
      "image": "game-brief-assets/2026-09-01-news-09.jpg"
    },
    {
      "title": "游戏科学说明持续投入实体艺术与线下空间",
      "date": "2026-08-31",
      "summary": "联合创始人杨奇表示实体作品能提供数字内容之外的质感与互动，杭州线下空间将更新展陈并于9月3日重开。",
      "source": "游民星空／游戏科学",
      "url": "https://www.gamersky.com/news/202608/2199883.shtml",
      "image": "game-brief-assets/2026-09-01-news-10.jpg"
    }
  ],
