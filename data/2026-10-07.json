      "image": "game-brief-assets/2026-10-07-beautiful-light.jpg"
    },
    {
      "id": "news-bf6-s5",
      "title": "《战地6》S5将带来三张维加斯地图",
      "date": "2026-10-06",
      "summary": "官方介绍称两张新地图随赛季上线，另一张后续推出。武器、载具平衡与服务器浏览器也在更新计划内。",
      "source": "3DM游戏网",
      "url": "https://www.3dmgame.com/news/202610/3955406.html",
      "image": "game-brief-assets/2026-10-07-bf6-s5.jpg"
    },
    {
      "id": "news-mh-outlanders",
      "title": "《怪物猎人：旅人》谈移动端创新边界",
      "date": "2026-10-06",
      "summary": "卡普空要求团队保留系列核心，同时探索正统作品之外的玩法。报道中的10月29日上线安排指国际服，国服日期尚未公布。",
      "source": "3DM游戏网",
      "url": "https://www.3dmgame.com/news/202610/3955402.html",
      "image": "game-brief-assets/2026-10-07-mh-outlanders.jpg"
    },
    {
      "id": "news-frostpunk-switch",
      "title": "《冰汽时代》完整版10月19日登陆Switch",
      "date": "2026-10-06",
      "summary": "此次移植面向初代Switch，完整版包含《最后的秋天》《裂缝》《帝国的边界》。具体画面和操作调整仍待说明。",
      "source": "3DM游戏网",
      "url": "https://www.3dmgame.com/news/202610/3955400.html",
      "image": "game-brief-assets/2026-10-07-frostpunk-switch.jpg"
    },
    {
      "id": "news-gta6-writing",
      "title": "《GTA6》编剧谈日常荒诞与叙事方向",
      "date": "2026-10-06",
      "summary": "团队称讽刺重点转向阴谋论和公众的日常反应，不逐一对应具体政客。长期开发也要求避免依赖短暂流行话题。",
      "source": "3DM游戏网",
      "url": "https://www.3dmgame.com/news/202610/3955394.html",
      "image": "game-brief-assets/2026-10-07-gta6-writing.jpg"
    },
    {
      "id": "news-nba2k25-offline",
      "title": "《NBA 2K25》10月底下架、明年停服",
      "date": "2026-10-06",
      "summary": "PlayStation商店将于10月30日下架，服务器计划2027年1月1日关闭。MyCareer等依赖在线服务的模式受影响，部分离线模式仍可游玩。",
      "source": "3DM游戏网",
      "url": "https://www.3dmgame.com/news/202610/3955391.html",
      "image": "game-brief-assets/2026-10-07-nba2k25-offline.jpg"
    },
    {
      "id": "news-gears-patch",
      "title": "《战争机器：事变日》补丁修复联机与战役",
      "date": "2026-10-06",
      "summary": "上线前更新处理等待玩家、身份验证与分屏登出等问题。战役进度、任务目标和部分模式异常也得到修复。",
      "source": "3DM游戏网",
      "url": "https://www.3dmgame.com/news/202610/3955390.html",
      "image": "game-brief-assets/2026-10-07-gears-patch.jpg"
    },
    {
      "id": "news-lol-worlds",
      "title": "《英雄联盟》S16观赛指南公布",
      "date": "2026-10-06",
      "summary": "赛事分入围赛、瑞士轮与淘汰赛，多数比赛在北京时间凌晨举行。入围赛10月16日开始，决赛安排在11月15日凌晨3点。",
      "source": "3DM游戏网",
      "url": "https://www.3dmgame.com/news/202610/3955418.html",
      "image": "game-brief-assets/2026-10-07-lol-worlds.jpg"
    },
    {
      "id": "news-ownership",
      "title": "前PS负责人再谈实体版与游戏所有权",
      "date": "2026-10-06",
      "summary": "肖恩·莱登在播客中质疑全数字策略对收藏玩家的影响。他强调数字访问许可与可转售的实体所有权存在差异，同时承认不了解公司内部财务数据。",
      "source": "3DM游戏网",
      "url": "https://www.3dmgame.com/news/202610/3955411.html",
      "image": "game-brief-assets/2026-10-07-ownership.jpg"
    },
    {
      "id": "news-marvel-rumor",
      "title": "传闻：《彗星计划》网传预告暗示四人合作",
      "date": "2026-10-06",
      "summary": "流传画面出现多位漫威英雄与半开放区域任务。相关内容仍属疑似泄露，最终玩法尚未正式公布。",
      "source": "3DM游戏网",
      "url": "https://www.3dmgame.com/news/202610/3955405.html",
